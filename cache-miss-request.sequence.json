{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Web Request: Cache Miss Flow",
    "output": "cache-miss-sequence.html",
    "viewBox": [1080, 560],
    "column_fit": "spread",
    "animation": "trace",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "browser",
      "type": "external",
      "label": "Browser",
      "sublabel": "client session"
    },
    {
      "id": "api",
      "type": "backend",
      "label": "API Server",
      "sublabel": "request handler"
    },
    {
      "id": "redis",
      "type": "database",
      "label": "Redis",
      "sublabel": "in-memory cache"
    },
    {
      "id": "postgres",
      "type": "database",
      "label": "PostgreSQL",
      "sublabel": "source of truth"
    }
  ],
  "segments": [
    { "from": 140, "to": 250, "label": "Initial Cache Lookup" },
    { "from": 260, "to": 390, "label": "Cache Miss & Database Query" },
    { "from": 400, "to": 500, "label": "Cache Fill & Client Response" }
  ],
  "messages": [
    {
      "id": "msg-1",
      "from": "browser",
      "to": "api",
      "y": 160,
      "label": "GET /api/v1/data",
      "variant": "default"
    },
    {
      "id": "msg-2",
      "from": "api",
      "to": "redis",
      "y": 200,
      "label": "GET cache:item:123",
      "variant": "default"
    },
    {
      "id": "msg-3",
      "from": "redis",
      "to": "api",
      "y": 235,
      "label": "(nil) cache miss",
      "variant": "return"
    },
    {
      "id": "msg-4",
      "from": "api",
      "to": "postgres",
      "y": 290,
      "label": "SELECT * FROM items WHERE id = 123",
      "variant": "default"
    },
    {
      "id": "msg-5",
      "from": "postgres",
      "to": "api",
      "y": 340,
      "label": "query result row",
      "variant": "return"
    },
    {
      "id": "msg-6",
      "from": "api",
      "to": "redis",
      "y": 420,
      "label": "SETEX cache:item:123 3600 payload",
      "variant": "default"
    },
    {
      "id": "msg-7",
      "from": "redis",
      "to": "api",
      "y": 450,
      "label": "OK",
      "variant": "return"
    },
    {
      "id": "msg-8",
      "from": "api",
      "to": "browser",
      "y": 485,
      "label": "200 OK (JSON response)",
      "variant": "return"
    }
  ]
}
